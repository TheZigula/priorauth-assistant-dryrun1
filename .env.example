# .env.example: owned by instance 4 (repo hygiene). Variable NAMES only, never values. Copy to .env for
# local runs; in the cloud each one is an encrypted setting in the host's dashboard, never a file.

# Backend: the agents run on Claude
ANTHROPIC_API_KEY=
# Backend embeddings (text-embedding-3-small) and the eval judge: a separate key with its own spend cap
OPENAI_API_KEY=
# Eval only: the judge model name (run_eval.py has the default)
EVAL_JUDGE=

# Front end: read by Vite from frontend/.env.development.local in dev and from the Vercel project settings in prod
# VITE_API_BASE=

# Deliberately absent: tracing keys. A trace would carry case fields off this machine (spec item 9).
